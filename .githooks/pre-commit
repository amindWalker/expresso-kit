#!/usr/bin/env bash
# =============================================================================
# Pre-Commit Hook for Expresso-Kit
# =============================================================================
# This hook runs before committing to catch issues early.
# It performs quick checks: formatting and basic linting on staged files.
#
# To install: run `git config core.hooksPath .githooks` from the repo root
# Or manually: cp .githooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# =============================================================================

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BLUE}  Expresso-Kit pre-commit check${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"

FAILED=0

# Check if there are any staged Rust files
STAGED_RS_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.rs$' || true)

if [ -z "$STAGED_RS_FILES" ]; then
    echo -e "${GREEN}  No Rust files staged, skipping checks${NC}"
    exit 0
fi

# Step 1: Check formatting
echo -e "\n${YELLOW}[1/2]${NC} Checking code formatting..."
if cargo +nightly fmt --all -- --check 2>/dev/null; then
    echo -e "${GREEN}  ✓ Formatting OK${NC}"
else
    echo -e "${RED}  ✗ Formatting issues found${NC}"
    echo -e "${YELLOW}  Run 'cargo +nightly fmt' to fix${NC}"
    FAILED=1
fi

# Step 2: Quick check (no full clippy, just compile check)
echo -e "\n${YELLOW}[2/2]${NC} Quick compile check..."
if cargo check --workspace 2>/dev/null; then
    echo -e "${GREEN}  ✓ Compile OK${NC}"
else
    echo -e "${RED}  ✗ Compile errors found${NC}"
    FAILED=1
fi

# Summary
echo -e "\n${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
if [ $FAILED -eq 0 ]; then
    echo -e "${GREEN}  ✓ Pre-commit checks passed!${NC}"
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    exit 0
else
    echo -e "${RED}  ✗ Pre-commit check failed${NC}"
    echo -e "${YELLOW}  Fix the issues above before committing${NC}"
    echo -e "${YELLOW}  Or use 'git commit --no-verify' to skip (not recommended)${NC}"
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    exit 1
fi
