# Test Project Environment Configuration Sample
# =============================================================================
# Copy this file to .env and fill in the values for your local environment.
# All variables have sensible defaults shown below.
# -----------------------------------------------------------------------------
APP_NAME=test-project
APP_ENV=development
APP_PORT=8080
APP_HOST=0.0.0.0
APP_LOG_LEVEL=debug
RUST_LOG=debug,sqlx=warn,tower_http=debug
RUST_BACKTRACE=1
# Database Configuration (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=test_project_db
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres_password
DATABASE_URL=postgres://postgres:postgres_password@localhost:5432/test_project_db
DATABASE_MAX_CONNECTIONS=10
DATABASE_MIN_CONNECTIONS=2
DATABASE_ACQUIRE_TIMEOUT=30
DATABASE_IDLE_TIMEOUT=600
# Redis Configuration
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret
REDIS_URL=redis://default:redis_secret@localhost:6379
REDIS_MAX_CONNECTIONS=10
REDIS_CONNECTION_TIMEOUT=5
# SQLx Migration Settings
# -----------------------------------------------------------------------------
SQLX_OFFLINE=false
SQLX_MIGRATION_PATH=./migrations
# API Configuration
# -----------------------------------------------------------------------------
API_VERSION=v1
API_PREFIX=/api
API_RATE_LIMIT=100
API_RATE_LIMIT_WINDOW=60
# JWT Authentication
# -----------------------------------------------------------------------------
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=86400
# CORS Configuration
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Request-ID
# Observability
# -----------------------------------------------------------------------------
OTEL_ENABLED=false
OTEL_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=test-project
METRICS_PORT=9090
# Feature Flags
# -----------------------------------------------------------------------------
FEATURE_NEW_AUTH=false
FEATURE_CACHE_ENABLED=true
FEATURE_RATE_LIMITING=true
# Docker Compose Specific (only used in docker-compose.yml)
# -----------------------------------------------------------------------------
RUST_VERSION=1.92.0
POSTGRES_VERSION=17-alpine
REDIS_VERSION=7-alpine
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=allkeys-lru
ADMINER_VERSION=latest
ADMINER_PORT=8081
ADMINER_DESIGN=nette
REDIS_COMMANDER_VERSION=latest
REDIS_COMMANDER_PORT=8082
